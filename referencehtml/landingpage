<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#151713">
  <meta name="description" content="Unmoved Studios — independent production for stories that refuse to sit still.">
  <title>un.moved studios — Independent production</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700;800;900&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--ink:#151713;--paper:#e9e4dc;--green:#193a2d;--red:#4a1120;--acid:#d8f16a;--muted:#6d6a64;--line:rgba(21,23,19,.24);--mono:'DM Mono',monospace;--sans:'DM Sans',Arial,sans-serif;--display:'Oswald','Arial Narrow',sans-serif;--gutter:clamp(22px,5vw,76px)}
    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:82px}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}img{display:block;max-width:100%}.eyebrow{font:10px var(--mono);letter-spacing:.13em;text-transform:uppercase}
    .topbar{position:fixed;inset:0 0 auto;z-index:20;min-height:74px;padding:12px var(--gutter);display:flex;align-items:center;justify-content:space-between;gap:24px;color:var(--paper);background:linear-gradient(180deg,rgba(21,23,19,.42),transparent);transition:background .25s}.topbar.is-visible{background:rgba(21,23,19,.94)}.brand{font:700 22px var(--display);letter-spacing:-.04em;text-transform:lowercase;line-height:.9}.brand small{display:block;margin-top:5px;font:9px var(--mono);letter-spacing:.16em;text-transform:uppercase}.nav{display:flex;gap:clamp(14px,2.4vw,36px);font:10px var(--mono);letter-spacing:.1em;text-transform:uppercase}.nav a{padding:8px 0;border-bottom:1px solid transparent}.nav a:hover{border-color:currentColor;color:var(--acid)}
    .hero{position:relative;min-height:100svh;display:grid;place-items:center;overflow:hidden;padding:90px var(--gutter);isolation:isolate;color:var(--paper);background:var(--green)}.hero:before{content:'';position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 70% 40%,rgba(216,241,106,.13),transparent 40%),linear-gradient(135deg,#193a2d,#101b16 76%)}.hero:after{content:'';position:absolute;inset:0;z-index:-1;opacity:.13;background-image:url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=2000&q=80');background-size:cover;background-position:center;mix-blend-mode:screen}.hero-content{width:min(1300px,100%)}.hero-kicker{font:10px var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--acid)}.hero-title{margin:18px 0 20px;font:600 clamp(94px,21vw,290px)/.76 var(--display);letter-spacing:-.055em;text-transform:uppercase}.hero-title span{display:block}.hero-bottom{display:flex;justify-content:space-between;align-items:end;gap:30px;padding-top:20px;border-top:1px solid rgba(233,228,220,.38)}.hero-tagline{margin:0;font:10px var(--mono);letter-spacing:.14em;text-transform:uppercase}.hero-index{font:10px var(--mono);letter-spacing:.12em}
    .studio-canvas{background:var(--paper) url('Texturelabs_Paper_300XL.jpg') center/cover fixed no-repeat}.about-services{padding:clamp(86px,12vw,155px) var(--gutter) clamp(65px,8vw,100px);display:grid;grid-template-columns:.75fr 1.25fr 1fr;gap:clamp(25px,4vw,62px)}.section-title{margin:0;font:600 clamp(42px,6.5vw,86px)/.88 var(--display);letter-spacing:-.04em;text-transform:uppercase}.about-copy{max-width:600px;margin:17px 0 0;font-size:clamp(16px,1.5vw,19px);line-height:1.75;color:#41423c}.services-heading{margin-bottom:20px}.service-card{display:grid;grid-template-columns:34px 1fr auto;gap:12px;align-items:center;padding:15px 0;border-top:1px solid var(--line)}.service-number,.service-hint{font:9px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.service-name{font:500 clamp(15px,1.4vw,18px) var(--sans)}
    .work{padding:clamp(30px,5vw,65px) var(--gutter) clamp(90px,12vw,150px)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:24px;padding-bottom:18px;border-bottom:1px solid var(--line)}.section-head h2{margin:0;font:600 clamp(48px,9vw,120px)/.9 var(--display);letter-spacing:-.045em;text-transform:uppercase}.section-head p{max-width:240px;margin:0;font:10px/1.6 var(--mono);text-align:right;text-transform:uppercase}.work-controls{display:flex;align-items:center;gap:20px;margin:20px 0 27px;font:10px var(--mono);letter-spacing:.1em;text-transform:uppercase}.filter-label{color:var(--muted);margin-right:4px}.filter-button{padding:5px 0;border:0;border-bottom:1px solid transparent;background:none;color:var(--ink);cursor:pointer;font:inherit;letter-spacing:inherit;text-transform:inherit}.filter-button:hover,.filter-button[aria-pressed=true]{border-color:currentColor}.filter-button[aria-pressed=true]{color:var(--red)}.filter-button:focus-visible,.project-tile:focus-visible{outline:2px solid #596a20;outline-offset:4px}.project-wall{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:start;gap:clamp(22px,3vw,42px) clamp(12px,1.7vw,24px)}.project-tile{position:relative;display:block;overflow:hidden;background:#d4cec3}.project-tile:nth-child(4n+2){margin-top:42px}.project-tile:nth-child(4n+3){margin-top:84px}.project-image{aspect-ratio:3/4;overflow:hidden;background:var(--green)}.project-image img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.project-tile:hover img{transform:scale(1.04)}.project-image:after{content:'';position:absolute;inset:35% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.76))}.project-meta{position:absolute;inset:auto 12px 14px;color:#fff}.project-type{font:9px var(--mono);letter-spacing:.12em;text-transform:uppercase}.project-title{margin:6px 0 0;font:500 clamp(19px,2.1vw,30px)/1 var(--display);text-transform:uppercase}.project-tile[hidden]{display:none}
    .manifesto{padding:clamp(80px,11vw,150px) var(--gutter);background:#d8c65c;color:var(--ink)}.manifesto-title{margin:24px 0 32px;padding-bottom:20px;border-bottom:1px solid var(--line);font:600 clamp(52px,11vw,145px)/.86 var(--display);letter-spacing:-.05em;text-transform:uppercase}.manifesto-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}.manifesto-grid p{max-width:620px;margin:0;font-size:clamp(16px,1.6vw,20px);line-height:1.7}.contact{padding:clamp(70px,10vw,130px) var(--gutter) 30px;background:var(--red);color:var(--paper)}.contact .eyebrow{color:var(--acid)}.contact h2{max-width:1050px;margin:24px 0;font:600 clamp(56px,11vw,145px)/.86 var(--display);letter-spacing:-.045em;text-transform:uppercase}.contact-link{display:inline-block;margin:12px 0 60px;padding-bottom:8px;border-bottom:1px solid currentColor;font:clamp(15px,2vw,22px) var(--mono)}.contact-footer{display:flex;justify-content:space-between;gap:20px;padding-top:20px;border-top:1px solid rgba(233,228,220,.35);font:9px var(--mono);letter-spacing:.1em;text-transform:uppercase}
    @media(max-width:900px){.about-services{grid-template-columns:1fr 1fr;gap:34px}.section-title{grid-column:1/-1}.project-wall{grid-template-columns:repeat(2,minmax(0,1fr))}.project-tile:nth-child(4n+2),.project-tile:nth-child(4n+3){margin-top:0}.project-tile:nth-child(even){margin-top:38px}}
    @media(max-width:760px){.topbar{min-height:64px}.nav{gap:14px;font-size:9px}.nav a:nth-child(2){display:none}.hero{min-height:100svh}.hero-title{font-size:clamp(78px,20vw,150px)}.hero-bottom{align-items:flex-start;flex-direction:column}.section-head{align-items:flex-start;flex-direction:column}.section-head p{text-align:left}.manifesto-grid{grid-template-columns:1fr;gap:20px}.contact-footer{flex-wrap:wrap}}
    @media(max-width:420px){.nav a:first-child{display:none}.work-controls{gap:13px;font-size:9px}.project-wall{gap:20px 10px}.project-meta{inset:auto 7px 8px;letter-spacing:0}.project-title{font-size:18px}.project-type{font-size:8px}.service-card{grid-template-columns:25px 1fr}.service-hint{display:none}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
  </style>
</head>
<body>
  <header class="topbar" id="siteHeader"><a href="#home" class="brand">un.moved<small>studios</small></a><nav class="nav" aria-label="Main navigation"><a href="#studio">Inside the studio</a><a href="#work">Selected work</a><a href="#manifesto">Manifesto</a><a href="#contact">Contact</a></nav></header>
  <main>
    <section class="hero" id="home" aria-label="Unmoved Studios"><div class="hero-content"><div class="hero-kicker">Independent Artist Production House</div><h1 class="hero-title"><span>un.</span><span>moved</span></h1><div class="hero-bottom"><p class="hero-tagline">Stories that refuse to sit still.</p><span class="hero-index">EST. 2020 / INDEPENDENT FILM</span></div></div></section>
    <div class="studio-canvas">
      <section class="about-services" id="studio" aria-labelledby="studioTitle"><h2 class="section-title" id="studioTitle">Inside the Studio</h2><div class="about-panel"><div class="eyebrow">About us</div><p class="about-copy">Unmoved is an award-winning, queer-led production studio dedicated to visual storytelling through film, art and community. We make thoughtful work with people and ideas that move us.</p></div><div class="services-panel"><div class="services-heading"><div class="eyebrow">What we do</div></div><div class="service-list" aria-label="Studio services"><div class="service-card"><span class="service-number">01</span><span class="service-name">Research &amp; Development</span><span class="service-hint">Discover</span></div><div class="service-card"><span class="service-number">02</span><span class="service-name">Production</span><span class="service-hint">Imagine</span></div><div class="service-card"><span class="service-number">03</span><span class="service-name">Edit and finishing</span><span class="service-hint">Create</span></div><div class="service-card"><span class="service-number">04</span><span class="service-name">Distribution</span><span class="service-hint">Deliver</span></div></div></div></section>
      <section class="work" id="work"><div class="section-head"><h2>Selected Work</h2><p>Select a project to explore</p></div><div class="work-controls" role="group" aria-label="Filter projects by status"><span class="filter-label">Filter</span><button class="filter-button" type="button" aria-pressed="true" data-filter="all">All</button><button class="filter-button" type="button" aria-pressed="false" data-filter="completed">Completed</button><button class="filter-button" type="button" aria-pressed="false" data-filter="in-progress">In progress</button></div>
        <div class="project-wall" id="projectWall" aria-label="Selected projects">
          <a class="project-tile" href="work/searching-4-saturn/" data-status="completed" aria-label="Searching 4 Saturn, Non-fiction short film, 2026"><div class="project-image"><img src="https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Night sky over a distant landscape" loading="lazy"></div><div class="project-meta"><div class="project-type">Non-fiction short film / 2026</div><h3 class="project-title">Searching 4 Saturn</h3></div></a>
          <a class="project-tile" href="work/tending-to-the-soul/" data-status="completed" aria-label="Tending to the Soul, Documentary short film, 2025"><div class="project-image"><img src="https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Soft light across an open field" loading="lazy"></div><div class="project-meta"><div class="project-type">Documentary short film / 2025</div><h3 class="project-title">Tending to the Soul</h3></div></a>
          <a class="project-tile" href="work/heirlooms-in-bloom/" data-status="completed" aria-label="Heirlooms in Bloom, Documentary short film, 2024"><div class="project-image"><img src="https://images.unsplash.com/photo-1490750967868-88aa4486c946?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Flowers in warm natural light" loading="lazy"></div><div class="project-meta"><div class="project-type">Documentary short film / 2024</div><h3 class="project-title">Heirlooms in Bloom</h3></div></a>
          <a class="project-tile" href="work/everything-we-leave-behind/" data-status="in-progress" aria-label="Everything We Leave Behind, Feature documentary, in progress"><div class="project-image"><img src="https://images.unsplash.com/photo-1518837695005-2083093ee35b?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Ocean waves under a quiet sky" loading="lazy"></div><div class="project-meta"><div class="project-type">Feature documentary / In progress</div><h3 class="project-title">Everything We Leave Behind</h3></div></a>
          <a class="project-tile" href="work/the-cloud-that-drank-the-south/" data-status="in-progress" aria-label="The Cloud That Drank the South, Feature documentary, in progress"><div class="project-image"><img src="https://images.unsplash.com/photo-1534088568595-a066f410bcda?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Cloud formations moving across the sky" loading="lazy"></div><div class="project-meta"><div class="project-type">Feature documentary / In progress</div><h3 class="project-title">The Cloud That Drank the South</h3></div></a>
          <a class="project-tile" href="work/untitled-nelson-sullivan-project/" data-status="in-progress" aria-label="Sullivision, Feature documentary, in progress"><div class="project-image"><img src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Camera ready to record" loading="lazy"></div><div class="project-meta"><div class="project-type">Feature documentary / In progress</div><h3 class="project-title">Sullivision</h3></div></a>
          <a class="project-tile" href="work/undone-and-done-again/" data-status="in-progress" aria-label="Undone and Done Again, Experimental documentary, in post-production"><div class="project-image"><img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Mountain landscape in the distance" loading="lazy"></div><div class="project-meta"><div class="project-type">Experimental documentary / Post-production</div><h3 class="project-title">Undone and Done Again</h3></div></a>
          <a class="project-tile" href="work/project-eight/" data-status="in-progress" aria-label="Project eight, coming soon"><div class="project-image"><img src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Distant mountain reflected in a lake" loading="lazy"></div><div class="project-meta"><div class="project-type">Coming soon</div><h3 class="project-title">Project Eight</h3></div></a>
        </div>
      </section>
    </div>
    <section class="manifesto" id="manifesto"><div class="eyebrow">Manifesto</div><h2 class="manifesto-title">A manifesto for the un.resolved</h2><div class="manifesto-grid"><p>We believe the stories that matter most are rarely simple. They ask us to stay curious, embrace contradiction and look again.</p><p>We make independent work with care and intention—creating space for voices, images and ideas that challenge the expected and open up new ways of seeing.</p></div></section>
    <section class="contact" id="contact"><div class="eyebrow">Contact</div><h2>Have a question<br>worth asking?</h2><a class="contact-link" href="mailto:info@unmovedstudios.com">info@unmovedstudios.com ↗</a><div class="contact-footer"><span>Unmoved Studios © 2026</span><a href="#home">Back to top ↑</a><span>Independent by nature.</span></div></section>
  </main>
  <script>
    (()=>{
      const header=document.querySelector('#siteHeader'),hero=document.querySelector('.hero');
      if('IntersectionObserver'in window){new IntersectionObserver(([entry])=>header.classList.toggle('is-visible',!entry.isIntersecting),{threshold:0}).observe(hero)}
      const filters=[...document.querySelectorAll('.filter-button')],tiles=[...document.querySelectorAll('.project-tile')];
      filters.forEach(button=>button.addEventListener('click',()=>{filters.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));const filter=button.dataset.filter;tiles.forEach(tile=>tile.hidden=filter!=='all'&&tile.dataset.status!==filter)}));
    })();
  </script>
</body>
</html>
